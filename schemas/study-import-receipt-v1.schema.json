{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-copilot:schema:study-import-receipt:v1",
  "title": "Knowledge Copilot Study Import Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcome",
    "importID",
    "packID",
    "previousPackContentHash",
    "resultingPackContentHash",
    "appliedAt",
    "approvedQuestionFamilyIDs",
    "approvedResponseCardIDs",
    "reviewer",
    "reviewedAt",
    "recoveredInterruptedTransaction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "outcome": { "enum": ["applied", "already_applied", "no_changes"] },
    "importID": { "type": "string", "pattern": "^import-[a-f0-9]{24}$" },
    "packID": { "type": "string", "minLength": 1, "maxLength": 200 },
    "previousPackContentHash": { "$ref": "#/$defs/hash" },
    "resultingPackContentHash": { "$ref": "#/$defs/hash" },
    "appliedAt": { "type": "string", "format": "date-time" },
    "approvedQuestionFamilyIDs": { "$ref": "#/$defs/idArray" },
    "approvedResponseCardIDs": { "$ref": "#/$defs/idArray" },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "recoveredInterruptedTransaction": { "type": "boolean" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "idArray": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}
